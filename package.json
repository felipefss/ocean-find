{
  "name": "ocean-find",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter web exec tsc --noEmit && pnpm --filter scraper exec tsc --noEmit && pnpm --filter db exec tsc --noEmit",
    "test": "pnpm -r vitest run",
    "test:watch": "pnpm -r vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "typescript": "^6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": ["biome check --write --no-errors-on-unmatched"]
  }
}
