# ─── Shared ───────────────────────────────────────────────────────────────────
# Random 32-char secret — shared between apps/web and apps/scraper for JWT validation
AUTH_SECRET=

# Neon PostgreSQL connection string
DATABASE_URL=

# ─── apps/web ─────────────────────────────────────────────────────────────────
# Full URL of the deployed Next.js app (used by Auth.js for callback URLs)
NEXTAUTH_URL=https://ocean-find.vercel.app

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL of the Render scraper service (no trailing slash)
NEXT_PUBLIC_SCRAPER_URL=https://ocean-find-scraper.onrender.com

# ─── apps/scraper ─────────────────────────────────────────────────────────────
# Adzuna API credentials (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Port for the scraper Express server (default: 3001)
PORT=3001
